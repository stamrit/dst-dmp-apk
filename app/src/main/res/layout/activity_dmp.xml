<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dmp_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@color/dmp_toolbar"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/dmp_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dmp_back"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/dmp_text_primary" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/dmp_title"
            android:src="@drawable/dmp_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dmp_launcher_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="@string/dmp_launcher_title"
                android:textColor="@color/dmp_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/dmp_launcher_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dmp_launcher_subtitle"
                android:textColor="@color/dmp_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/dmp_download_tasks"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dmp_download_tasks"
            android:padding="11dp"
            android:src="@drawable/ic_dmp_download_tasks"
            app:tint="@color/dmp_primary_text" />

        <ImageButton
            android:id="@+id/dmp_update_servers"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dmp_update_servers"
            android:padding="11dp"
            android:src="@drawable/ic_dmp_server_update"
            app:tint="@color/dmp_primary_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dmp_room_mode"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="60dp"
            android:text="@string/dmp_show_rooms"
            android:textAllCaps="false"
            android:textColor="@color/dmp_primary_text"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/dmp_refresh_all"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dmp_refresh_all"
            android:padding="12dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="@color/dmp_primary" />

        <ImageButton
            android:id="@+id/dmp_theme_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dmp_theme_day"
            android:padding="11dp"
            android:src="@drawable/ic_dmp_sun_line"
            app:tint="@color/dmp_primary_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dmp_server_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dmp_page"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/dmp_room_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorColor="@color/dmp_primary"
            app:trackColor="@color/dmp_track" />

        <TextView
            android:id="@+id/dmp_room_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/dmp_room_empty"
            android:textColor="@color/dmp_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
